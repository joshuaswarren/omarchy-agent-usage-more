#!/usr/bin/python3
# omarchy:summary=Print the OpenCode Go subscription usage record from the omp auth broker
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""OpenCode Go / Zen subscription windows, read from the omp auth broker.

Distinct from a local OpenCode token-stats collector: this is the paid plan's
5-hour / weekly / monthly allowance, which only the account behind the
credential can report.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import agentusage as au  # noqa: E402
import broker  # noqa: E402

AGENT_ID = "opencode-go"
AGENT_NAME = "OpenCode Go"
BROKER_PROVIDER = "opencode-go"
AUTH_HELP = "Add an OpenCode Go credential with `omp auth-broker login opencode-go`."


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the OpenCode Go usage record")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()
    return au.run(
        AGENT_ID,
        AGENT_NAME,
        lambda: broker.scan_provider(AGENT_ID, AGENT_NAME, BROKER_PROVIDER, "Plan"),
        AUTH_HELP,
    )


if __name__ == "__main__":
    raise SystemExit(main())
