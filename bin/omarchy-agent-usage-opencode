#!/usr/bin/python3
# omarchy:summary=Print the OpenCode plan usage record from the omp auth broker
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""OpenCode plan windows (the paid Go / Zen subscription), from the omp auth broker.

This owns the `opencode` agent id: the plan allowance is what belongs on the
bar, not local token tallies. Pair it with the override in
`adapters-overrides/opencode/` so the local-stats adapter in
rohaquinlop/agent-collectors stops writing this same record.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import agentusage as au  # noqa: E402
import broker  # noqa: E402

AGENT_ID = "opencode"
AGENT_NAME = "OpenCode"
BROKER_PROVIDER = "opencode-go"
AUTH_HELP = "Add an OpenCode Go credential with `omp auth-broker login opencode-go`."


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the OpenCode Go usage record")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()
    return au.run(
        AGENT_ID,
        AGENT_NAME,
        lambda: broker.scan_provider(AGENT_ID, AGENT_NAME, BROKER_PROVIDER, "Plan"),
        AUTH_HELP,
    )


if __name__ == "__main__":
    raise SystemExit(main())
